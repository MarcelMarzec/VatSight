<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1) Force HTTPS and strip a "www." prefix in one hop
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://vatsight.com%{REQUEST_URI} [L,R=301]

# 2) Canonicalize /index or /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 3) Canonicalize any other /page.html -> /page (drop the extension)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 4) Serve the matching .html file for the extensionless URL, without redirecting
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
</IfModule>
