<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		VatSight PrivacyInfo.xcprivacy

		VatSight's own code does not collect, store, or transmit any personal data.
		The app's own code does not call any required-reason APIs directly.
		Third-party SDKs (MapboxMaps, ZIPFoundation, GEOSwift, GoogleMobileAds,
		UserMessagingPlatform) ship their own privacy manifests covering their
		own data collection and required-reason API usage.

		Network domains accessed by VatSight:
		  - data.vatsim.net       (live VATSIM network data, public API)
		  - api.github.com        (VATGlasses airspace sector data, public repo)
		  - *.mapbox.com          (map tile rendering via MapboxMaps SDK)
		  - Google ad servers     (only after the user opts in to optional ads)
	-->

	<!--
		Optional ads are off by default. When a user opts in and allows App Tracking
		Transparency, the Google Mobile Ads SDK may use the IDFA for tracking.
	-->
	<key>NSPrivacyTracking</key>
	<true/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
		Required-reason APIs: VatSight's own code does not directly call any of
		the required-reason API categories. SDK-level usage is covered by each
		SDK's own bundled privacy manifest.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>

	<!--
		Collected data types: VatSight's own code collects NO data from users.

		- The VATSIM CID, friend CIDs, preferences, ad settings, the ads-viewed
		  counter and last map position are stored on-device only.
		- Ad-related data (device ID, advertising data, product interaction,
		  diagnostics, coarse location) is collected by the Google Mobile Ads SDK
		  only while optional ads are enabled, and is declared in its own manifest.
		- No health, financial, precise location, contact, or biometric data is accessed.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
</dict>
</plist>
